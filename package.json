{
  "name": "rts",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "server": "tsx watch src/server/listen.ts",
    "start": "tsx src/server/listen.ts",
    "client": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "proto": "buf generate"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "three": "^0.186.1"
  }
}
